# Optional external-model smoke-test configuration only.
# Normal tests, scripts/demo.py, and the Next.js frontend do not require these values.
AGENTLAB_LLM_API_KEY=
AGENTLAB_LLM_BASE_URL=
AGENTLAB_LLM_MODEL=
AGENTLAB_LLM_TIMEOUT_SECONDS=30

# Deployment / cross-origin configuration.
# Local defaults already allow http://localhost:3000 and http://127.0.0.1:3000.
AGENTLAB_CORS_ORIGINS=
AGENTLAB_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Frontend project only: set this to the deployed AgentLab API origin,
# e.g. https://agentlab-api.example.vercel.app
NEXT_PUBLIC_AGENTLAB_API_URL=
